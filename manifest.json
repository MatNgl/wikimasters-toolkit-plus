{
  "manifest_version": 3,
  "name": "WikiMasters Toolkit+",
  "version": "0.30.0",
  "description": "Prix du marché, ouverture de paquets en un clic, enchères automatiques et style de cartes pour WikiMasters.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.wiki-masters.com/*"
  ],
  "action": {
    "default_title": "WikiMasters Toolkit+",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wiki-masters.com/*"
      ],
      "js": [
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.wiki-masters.com/*"
      ],
      "js": [
        "src/lib/namespace.js",
        "src/lib/logic.js",
        "src/lib/storage.js",
        "src/lib/journal.js",
        "src/lib/dom.js",
        "src/lib/activity.js",
        "src/lib/sniffer.js",
        "src/features/stats.js",
        "src/features/card-detail.js",
        "src/features/reveal.js",
        "src/features/settings-modal.js",
        "src/features/boosters.js",
        "src/features/prices.js",
        "src/features/quick-auction.js",
        "src/features/auto-sell.js",
        "src/features/auctions.js",
        "src/features/inventory.js",
        "src/features/card-style.js",
        "src/features/discard.js",
        "src/features/collection-native.js",
        "src/features/dashboard.js",
        "src/features/market.js",
        "src/features/trades.js",
        "src/features/update-banner.js",
        "src/content.js"
      ],
      "css": [
        "src/toolkit.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.wiki-masters.com/*"
      ],
      "js": [
        "src/frame-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "version_name": "0.30.0 · défausse : prix inconnus (garder, défausser, attendre, en dernier) ; alerte deux copies de l’extension ; défausse calée sur le vrai jeu (filtres, compteur, fenêtre, relecture) ; défausse en arrière-plan (page invisible, progression N / total) ou visible ; paquets : compte Pro (3 min) ou classique (10 min), heure exacte du prochain paquet ; défausse par critères (sélection native du jeu, essai à blanc) ; assistant de vente : raretés exclusives et dans l’ordre",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  }
}
